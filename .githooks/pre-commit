#!/usr/bin/env python3

import subprocess
import sys

BLOCKED = (
    "clients/",
    "studies/",
    # Legacy flat locations (pre-v3)
    "personas/",
    "evidence/",
    "holdout/",
    "calibration/",
)

ALLOWED = (
    "clients/_template/",
    "studies/_template/",
)

result = subprocess.run(
    ["git", "diff", "--cached", "--name-only", "--diff-filter=ACMR"],
    capture_output=True,
    text=True,
    check=True,
)

bad_files = []

for path in result.stdout.splitlines():
    if (
        path.startswith(BLOCKED)
        and not path.startswith(ALLOWED)
        and not path.endswith("/.gitkeep")
    ):
        bad_files.append(path)

if bad_files:
    print("Commit blocked: client-data paths are staged:")
    for path in bad_files:
        print(f"  {path}")
    sys.exit(1)

sys.exit(0)
